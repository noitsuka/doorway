DATABASE_URL=postgresql+asyncpg://doorway:doorway@localhost:5432/doorway
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
CORS_ORIGINS=["http://localhost:3000"]

# Em serverless (Vercel), sem pool de conexões entre requisições.
DB_NULL_POOL=false
# Só atrás de um proxy que sobrescreve X-Real-IP, como a Vercel.
TRUST_REAL_IP_HEADER=false
